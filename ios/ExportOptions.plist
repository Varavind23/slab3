<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Store Connect distribution. `destination: upload` sends the build
         straight to TestFlight; switch to `export` to inspect the .ipa first. -->
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>7BMY83MWA8</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <!-- dSYMs, so TestFlight crash reports symbolicate. -->
    <key>uploadSymbols</key>
    <true/>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
